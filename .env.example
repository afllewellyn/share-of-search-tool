# Copy to `.env` and fill in your own values, or export these in your shell.
# `.env` is gitignored. Never commit real credentials.
#
# Sign up at https://dataforseo.com/ — the Keywords Data API is pay-as-you-go
# and a Share of Search run costs roughly $0.075 (billed per request, not per
# keyword, so all brands go out in a single call).

DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# DATAFORSEO_USERNAME is accepted as an alias for DATAFORSEO_LOGIN if you
# already have it set from another tool. DATAFORSEO_LOGIN wins if both exist.
# DATAFORSEO_USERNAME=your-dataforseo-login
